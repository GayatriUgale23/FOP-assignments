Problem Statement- generate multiplication tables for given number

#include <stdio.h>

int main() {
    int num, range;

    // Get the number for the table
    printf("Enter an integer to generate its table: ");
    scanf("%d", &num);

    // Get the range (how far the table should go)
    printf("Enter the range (e.g., up to 10 or 12): ");
    scanf("%d", &range);

    printf("\nMultiplication Table for %d:\n", num);
    printf("---------------------------\n");

    // Loop to calculate and print each line
    for (int i = 1; i <= range; ++i) {
        printf("%d x %d = %d\n", num, i, num * i);
    }

    return 0;
}
